{
  "name": "dental-atelier",
  "version": "1.0.0",
  "private": true,
  "description": "Dental Atelier - a state-of-the-art dental laboratory. Next.js + Tailwind + Prisma/MySQL + NextAuth, with an admin portal and a client portal.",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "next dev -p 3031",
    "build": "prisma generate && next build",
    "start": "next start -p 3031",
    "lint": "eslint .",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "db:studio": "prisma studio",
    "create-admin": "node scripts/create-admin.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "5.19.1",
    "bcryptjs": "2.4.3",
    "formidable": "3.5.1",
    "next": "15.5.27",
    "next-auth": "4.24.11",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.27",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "postcss": "8.4.47",
    "prisma": "5.19.1",
    "tailwindcss": "3.4.13"
  }
}