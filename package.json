{
  "name": "dental-atelier",
  "version": "1.0.0",
  "private": true,
  "description": "Dental Atelier - a state-of-the-art dental laboratory. Next.js + Tailwind + Prisma/MySQL + NextAuth, with an admin portal and a client portal.",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "next dev -p 3031",
    "build": "prisma generate && next build",
    "start": "next start -p 3031",
    "lint": "eslint .",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "db:studio": "prisma studio",
    "create-admin": "node scripts/create-admin.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "5.19.1",
    "bcryptjs": "3.0.3",
    "formidable": "3.5.4",
    "next": "16.3.8",
    "next-auth": "4.24.15",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "postcss": "8.5.28",
    "prisma": "5.19.1",
    "tailwindcss": "3.4.13",
    "zod": "4.6.5"
  }
}
