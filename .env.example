# ---------------------------------------------------------------------------
# Dental Atelier - environment template.
#
#   cp .env.example .env
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
# Every value the app reads is listed here — nothing is hardcoded in the code.
# ---------------------------------------------------------------------------

# --- Application identity ----------------------------------------------------
# The name shown in the navbar, the admin shell, the e-mails and the Open Graph
# tags. `NEXT_PUBLIC_` is inlined into the browser bundle, so both must be set
# to the same value.
APP_NAME="Dental Atelier"
NEXT_PUBLIC_APP_NAME="Dental Atelier"
# The legal entity behind the brand (used in the JSON-LD organisation block).
# `NEXT_PUBLIC_` is inlined into the browser bundle, so both must be set to
# the same value.
APP_LEGAL_NAME="Dental Atelier Michal Siakel"
NEXT_PUBLIC_APP_LEGAL_NAME="Dental Atelier Michal Siakel"
# The public contact address. Shown in the footer, in the JSON-LD and in the
# notification e-mails, so it follows the same rule as the names above.
CONTACT_EMAIL="contact@example.com"
NEXT_PUBLIC_CONTACT_EMAIL="contact@example.com"

# --- Network ----------------------------------------------------------------
# The port the server listens on. `npm run dev` / `npm run start` read this, so
# changing it here is enough — no script, Dockerfile or manifest is touched.
PORT=4040
# The bind address. Next.js listens on every interface by default; set this
# explicitly to make the app reachable from other devices on the local
# network (e.g. HOST=0.0.0.0).
HOST=""
# The canonical origin. Used for NEXTAUTH's CSRF cookie, canonical URLs, the
# sitemap, robots.txt and the links inside notification e-mails.
NEXTAUTH_URL="http://localhost:4040"
NEXT_PUBLIC_SITE_URL="http://localhost:4040"

# --- Secrets ----------------------------------------------------------------
# openssl rand -base64 32
NEXTAUTH_SECRET=""
# MySQL connection string. The password must be percent-encoded: a literal
# `/` in the password breaks URL parsing (`/` becomes `%2F`).
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/DB_NAME"

# --- Administrator account --------------------------------------------------
# Used by `npm run db:seed` and `npm run create-admin`. Keep the password out
# of the running container once the account exists.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# --- Optional: Google OAuth -------------------------------------------------
# The provider is only enabled when both are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- SMTP notifications -----------------------------------------------------
# `SMTP_PROVIDER` picks the default port for known providers (gmail, smtp,
# sendgrid, mailgun, local); anything else must set `SMTP_HOST` and
# `SMTP_PORT` explicitly. With no credentials the mailer only logs a preview.
SMTP_PROVIDER="gmail"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
# For Gmail this is an *app* password, not the account password.
SMTP_PASSWORD=""
# The envelope sender; defaults to SMTP_USER when empty.
SMTP_FROM=""
# `false` keeps the conversation in plaintext — only for a trusted local
# relay. Port 465 is implicit TLS; 587 negotiates it with STARTTLS.
SMTP_STARTTLS="true"
# How long to wait for the server before giving up, in milliseconds.
SMTP_TIMEOUT_MS="20000"
# Where inquiry and appointment notifications are delivered.
NOTIFY_EMAIL="hello@example.com"

# --- Storage ----------------------------------------------------------------
# Where the transcoded gallery images are written, relative to the project
# root. The default is the directory Next serves statically.
GALLERY_STORAGE_DIR="public/uploads"
# Where the raw upload is staged before it is transcoded.
GALLERY_TEMP_DIR=".tmp-uploads"
# The public URL prefix the stored images are served under.
GALLERY_URL_PREFIX="/uploads"

# --- Scheduling -------------------------------------------------------------
# The studio's timezone, shown on the booking form.
APPOINTMENT_TIME_ZONE="Europe/Brussels"
# How long one appointment slot lasts, in minutes.
APPOINTMENT_DURATION_MINUTES=30

# --- Behaviour --------------------------------------------------------------
# Extra origins allowed to POST to the public forms, comma separated.
# A bare host matches every port on that host, so the list does not have to
# repeat the port. Empty means same-origin only.
ALLOWED_ORIGINS="127.0.0.1,0.0.0.0"
# Adds the underlying error message to API responses. Leave off in production
# unless you are troubleshooting.
DEBUG_MODE="false"
