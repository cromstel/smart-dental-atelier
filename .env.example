# ---------------------------------------------------------------------------
# Dental Atelier - environment template. Copy to `.env` and fill in.
# NEVER commit the real .env (see .gitignore).
# ---------------------------------------------------------------------------

# MySQL connection string used by Prisma.
# Local:  mysql://USER:PASSWORD@127.0.0.1:3306/smart_dental_atelier
# Hostinger / production: use the remote host created via the hPanel
#   "Remote MySQL" screen, not 127.0.0.1.
DATABASE_URL="mysql://smart_dental_atelier:CHANGE_ME@127.0.0.1:3306/smart_dental_atelier"

# NextAuth - generate with: "openssl rand -base64 32"
# The app listens on 4040 (set in package.json and Docker). Keep this in sync.
NEXTAUTH_URL="http://localhost:4040"
NEXTAUTH_SECRET="CHANGE_ME_generate_a_32_byte_secret"

# Credentials login
ADMIN_EMAIL="admin@smart-dentalatelier.cromstelit.com"
ADMIN_PASSWORD="CHANGE_ME"           # only used by `npm run db:seed`

# Optional: Google OAuth (enable the provider only when both are set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Where the site thinks it lives (used for canonical URLs, sitemap, OG tags).
# Leave the production value in place even locally, so canonical URLs in the
# build always match the real domain.
NEXT_PUBLIC_SITE_URL="https://smart-dentalatelier.cromstelit.com"

# SMTP notifications for new appointments / inquiries.
# Leave empty to log notifications instead of sending them.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
NOTIFY_EMAIL="hello@cromstelit.com"

# Comma separated list of origins allowed to POST to public forms.
# Defaults to same-origin only when unset.
ALLOWED_ORIGINS=""


# ============================================
# NOTIFY_EMAIL in .env.local also points to the .local address (it was set to the admin address there), so dev notifications land in the same place. .env keeps cromstelapp@gmail.com for real mail.
# The seeded admin's password is ChangeMe-2026! from .env — I reset the hash earlier so it matches. Change it before any real deployment (npm run create-admin).
